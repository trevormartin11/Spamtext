# ---- Supabase (Project Settings -> API) ----
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- Auth for the phone app and cron ----
# Any long random string; the Android app sends it as X-Api-Key
APP_API_KEY=
# Vercel sets CRON_SECRET automatically when you add it in project env vars
CRON_SECRET=
# Password for the web dashboard (basic auth, username is anything)
DASHBOARD_PASSWORD=

# ---- Your details (used in complaints, demand letters, small claims packet) ----
USER_FULL_NAME=
USER_PHONE=+16025551234
USER_EMAIL=
USER_ADDRESS_LINE1=
USER_ADDRESS_LINE2=
USER_CITY=
USER_STATE=AZ
USER_ZIP=
USER_COUNTY=Maricopa

# ---- Twilio Lookup (Console -> Account Info) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ---- Anthropic (sender identification + letter facts) ----
ANTHROPIC_API_KEY=

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# random string you choose; Telegram sends it back on every webhook call
TELEGRAM_WEBHOOK_SECRET=

# ---- Lob (certified mail for demand letters) ----
LOB_API_KEY=
# estimated cost per certified letter, used for the monthly cap
LOB_CERTIFIED_LETTER_CENTS=900

# ---- Optional: email delivery of demand letters via Resend ----
RESEND_API_KEY=
RESEND_FROM=

# ---- Public URL of this deployment (for links in Telegram) ----
PUBLIC_BASE_URL=https://spamtext.vercel.app
